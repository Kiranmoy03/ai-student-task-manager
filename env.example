# Same project URL as the React frontend's VITE_SUPABASE_URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase publishable (sb_publishable_...) or legacy anon key; NOT a service role key.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Comma-separated frontend origins. Add your deployed domain when available.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
